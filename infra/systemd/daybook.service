# /etc/systemd/system/daybook.service
# Starts the Daybook Compose stack (postgres, daybook, caddy) after Docker is up.
# Enable on otuburu with:
#   sudo cp /opt/daybook/backend/infra/systemd/daybook.service /etc/systemd/system/daybook.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now daybook
[Unit]
Description=Daybook (Docker Compose stack)
Documentation=https://github.com/filatei/daybook
Requires=docker.service
After=docker.service docker.socket network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=daybookuser
Group=daybookuser
WorkingDirectory=/opt/daybook/backend
# Bring the whole stack up on boot. Containers themselves use restart: always;
# this unit only ensures `docker compose up` runs once Docker is ready.
ExecStart=/usr/bin/docker compose up -d --remove-orphans
# No ExecStop: do not `compose down`/`stop` on systemctl stop — that fights
# daybook-deploy and operators who manage containers via docker compose.
# To stop the stack intentionally: cd /opt/daybook/backend && docker compose stop
ExecReload=/usr/bin/docker compose up -d --remove-orphans
TimeoutStartSec=300
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
